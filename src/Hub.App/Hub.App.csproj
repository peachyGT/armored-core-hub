<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <AssemblyName>ArmoredCoreHub</AssemblyName><ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="'$(ApplicationIcon)' == ''">Assets/Hub.ico</ApplicationIcon>
    <DefineConstants Condition="'$(HubDiagnostics)' == 'true'">$(DefineConstants);HUB_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Hub.Core/Hub.Core.csproj"/>
    <Content Include="../../manifests/**/*.json" Link="manifests/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
    <Resource Include="Assets/*" />
    <Compile Remove="MainWindow.*Checks.cs" Condition="'$(HubDiagnostics)' != 'true'"/>
  </ItemGroup>
</Project>
