     <TabItem x:Name="SaveTab" Header="Save Data"><StackPanel><TextBlock Text="Save data" FontFamily="{StaticResource Display}" FontSize="24"/><TextBlock x:Name="SaveNotes" Style="{StaticResource Secondary}" Margin="0,10,0,18"/><WrapPanel><Button Content="Back up now" Click="BackupSaves"/><Button Content="Import saves…" Click="ImportSaves"/><Button Content="Open save folder" Click="OpenSaves"/></WrapPanel><TextBlock Text="Restore points" FontWeight="SemiBold" Margin="0,16,0,5"/><ComboBox x:Name="SnapshotBox" DisplayMemberPath="Label" SelectedValuePath="Id" AutomationProperties.Name="Save restore point"/><Button Content="Restore selected backup" Click="RestoreSaves" HorizontalAlignment="Left"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=SnapshotBox}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><TextBlock Text="Restoring first backs up your current progress. Shared memory-card families make original in-game save import available; the Hub does not convert saves between console platforms." Style="{StaticResource Secondary}" Margin="0,10,0,0"/></StackPanel></TabItem>
     <TabItem x:Name="AdvancedTab" Header="Advanced"><StackPanel><TextBlock Text="Emulator settings" FontFamily="{StaticResource Display}" FontSize="24"/><TextBlock Text="Emulator and configuration" Margin="0,18,0,0"/><ComboBox x:Name="ProfileBox" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="ProfileChanged" AutomationProperties.Name="Compatibility profile and backend"/><TextBlock Text="Registered copy"/><ComboBox x:Name="MediaBox" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="MediaChanged" AutomationProperties.Name="Registered game media"/><Button x:Name="ForgetMediaButton" Content="Forget this registration…" Click="ForgetMedia" HorizontalAlignment="Left"/><TextBlock Text="Emulator version"/><ComboBox x:Name="BuildBox" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="BuildChanged" AutomationProperties.Name="Emulator version"/><WrapPanel><Button Content="Install emulator" Click="InstallRuntime"/><Button Content="Check for newer build" Click="CheckUpdate"/><Button Content="Import emulator archive…" Click="ImportRuntime"/></WrapPanel><TextBlock x:Name="BuildNotes" Style="{StaticResource Secondary}" Margin="0,8,0,12"/><CheckBox x:Name="FullscreenBox" Content="Start in fullscreen" Checked="FullscreenChanged" Unchecked="FullscreenChanged"/><WrapPanel><Button Content="Verify media" Click="VerifyMedia"/><Button Content="Repair setup" Click="RepairSetup"/><Button Content="Open configuration" Click="OpenConfig"/></WrapPanel><TextBlock Text="Select another console edition above to use its backend. PS3 media cannot run in an Xbox 360 emulator." Style="{StaticResource Secondary}" Margin="0,8,0,12"/><TextBlock Text="Profile values (key=value, one per line)"/><TextBox x:Name="AdvancedText" AcceptsReturn="True" MinHeight="100" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Advanced profile overrides"/><Button Content="Save advanced overrides" Click="SaveAdvanced" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></TabItem>
     <TabItem x:Name="InfoTab" Header="Details"><StackPanel><ItemsControl x:Name="Readiness"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1" Padding="0,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="137"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{DynamicResource Muted}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="CompatibilityNotes" Margin="0,20,0,8" Style="{StaticResource Secondary}"/><Button Content="Compatibility sources" Click="OpenEvidence" HorizontalAlignment="Left"/></StackPanel></TabItem>
